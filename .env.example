# ============================================================
# ALEENA AI ENVIRONMENT CONFIGURATION
# ============================================================

# ------------------------------------------------------------
# SERVER
# ------------------------------------------------------------

NODE_ENV=development

PORT=8765
HOST=127.0.0.1
LOCAL_BRIDGE_PORT=8766
LOCAL_BRIDGE_HOST=127.0.0.1

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------

# Leave blank for local in-memory mode; set PostgreSQL URL for persistent local accounts and chats.
DATABASE_URL=

# ------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------

# Set a random secret of at least 32 characters. Node and the local Python bridge must share it.
JWT_SECRET=
# Set the exact email used by the administrator account.
MASTER_EMAIL=
# Use at least 32 random characters; never share this value.
MASTER_SETUP_KEY=

# ------------------------------------------------------------
# FRONTEND
# ------------------------------------------------------------

FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------
# GEMINI
# ------------------------------------------------------------

GEMINI_API_KEY=yourAPI

GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------
# FRONTEND API URLS
# ------------------------------------------------------------

NEXT_PUBLIC_API_URL=http://localhost:8765
NEXT_PUBLIC_LOCAL_BRIDGE_URL=http://localhost:8766
NEXT_PUBLIC_LOCAL_BRIDGE_WS_URL=ws://localhost:8766/ws

NEXT_PUBLIC_WS_URL=ws://localhost:8765/ws

# ------------------------------------------------------------
# OPTIONAL LEGACY COMPATIBILITY
# ------------------------------------------------------------

VITE_API_URL=http://localhost:8765

VITE_SOCKET_URL=ws://localhost:8765/ws
