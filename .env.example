# ============================================================
# ALEENA AI — GEMINI AI + LOCAL STORAGE
# Gemini handles AI responses; SQLite keeps application data on this PC.
# ============================================================

NODE_ENV=development
PORT=8765
HOST=127.0.0.1
LOCAL_BRIDGE_PORT=8766
LOCAL_BRIDGE_HOST=127.0.0.1

# Optional authenticated mobile access over your private home Wi-Fi.
# Generate a self-signed TLS certificate and copy its SHA-256 fingerprint into Android.
# Set LOCAL_LAN_ENABLED=true only when you are ready to pair a phone.
LOCAL_LAN_ENABLED=false
LOCAL_LAN_HOST=0.0.0.0
LOCAL_LAN_PORT=8767
LOCAL_TLS_CERT_FILE=./data/local-server-cert.pem
LOCAL_TLS_KEY_FILE=./data/local-server-key.pem

# Local SQLite file is stored on this PC.
DATABASE_MODE=sqlite
ALEENA_DATA_DIR=./data
DATABASE_URL=

# Local auth secret: generate a private random value of at least 32 characters.
# Do not commit your real .env file.
JWT_SECRET=
MASTER_EMAIL=
MASTER_SETUP_KEY=

FRONTEND_URL=http://localhost:3000

# Gemini AI requires internet access and a Google AI Studio API key.
# Prompts and relevant chat context are sent to Gemini; chat history stays in local SQLite.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Fast everyday replies use Flash-Lite; complex coding/analysis is routed to Flash.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REASONING_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=minimal
GEMINI_COMPLEX_THINKING_LEVEL=low

# Local browser frontend -> local Node API + Python voice bridge.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8765
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8765/ws
NEXT_PUBLIC_LOCAL_BRIDGE_URL=http://127.0.0.1:8766
NEXT_PUBLIC_LOCAL_BRIDGE_WS_URL=ws://127.0.0.1:8766/ws

# Optional legacy compatibility
VITE_API_URL=http://127.0.0.1:8765
VITE_SOCKET_URL=ws://127.0.0.1:8765/ws
